// Stat ids are never reused: table 10 and player 10 were the unused template "Number of turns".
// Captain and ship stats store 1-based indexes into SeasOfHavoc::STAT_CAPTAINS / STAT_SHIPS; the
// value_labels below must list them in the same order ("None" is 0).
// captain_N / ship_N are 1 for the player whose captain / ship is STAT_CAPTAINS / STAT_SHIPS entry N,
// else 0. They are for the Audience page, which averages number stats but leaves labelled ones out:
// a captain's "Winners' average" over its "All players' average" is how much more often it wins
// than its share of seats. "display": "limited" keeps them to developers.
{
    "table": {
        "rounds": {
            "id": 11,
            "name": "Rounds played",
            "type": "int"
        },
        "winning_captain": {
            "id": 12,
            "name": "Winning captain",
            "type": "int"
        },
        "winning_ship": {
            "id": 13,
            "name": "Winning ship",
            "type": "int"
        },
        "winning_captain_ship": {
            "id": 14,
            "name": "Winning captain and ship",
            "type": "int"
        },
